+/* vanderveer.io · Monoliths
+   Plain CSS on purpose: GitHub Pages copies it as-is, no Sass step. */
+
+/* ── Fonts (self-hosted, Latin subset, SIL OFL; licences in /assets/fonts) ── */
+@font-face{font-family:"Space Grotesk";src:url("../fonts/space-grotesk.woff") format("woff");font-weight:400 700;font-style:normal;font-display:swap}
+@font-face{font-family:"Inter";src:url("../fonts/inter.woff") format("woff");font-weight:400 600;font-style:normal;font-display:swap}
+@font-face{font-family:"JetBrains Mono";src:url("../fonts/jetbrains-mono.woff") format("woff");font-weight:400 500;font-style:normal;font-display:swap}
+@font-face{font-family:"JetBrains Mono";src:url("../fonts/jetbrains-mono-italic.woff") format("woff");font-weight:400;font-style:italic;font-display:swap}
+
+/* ── Theme tokens ───────────────────────────────────────────────────────── */
+:root,
+[data-theme="dark"]{
+  color-scheme:dark;
+  --bg:#0F1013;--bg2:#131418;--fg:#EDEEF0;--fgh:#FFFFFF;--body:#D6D8DD;--muted:#9CA1AB;--soft:#C9CCD2;--line:#2E3139;
+  --g1:#2B2E36;--g2:#24272E;--g3:#1E2026;--g4:#191B20;--g5:#15161A;--ds:#3A3E49;
+  --accent:#FFB547;--ink:#FFB547;--shadow:0 30px 60px rgba(0,0,0,.5);
+  --codebg:#16171C;--codebar:#1C1E24;--inline:#23252C;
+  --k:#D9A8FF;--s:#9FD8A8;--c:#7D838F;--m:#F5C17A;--f:#8CC8FF;
+}
+[data-theme="light"]{
+  color-scheme:light;
+  --bg:#F3F3F0;--bg2:#EAEAE5;--fg:#121317;--fgh:#000000;--body:#24262B;--muted:#585D67;--soft:#2E3138;--line:#D3D4CE;
+  --g1:#CFD0C8;--g2:#D8D9D2;--g3:#DFE0D9;--g4:#E5E6E0;--g5:#EBEBE6;--ds:#C2C3BC;
+  --accent:#FFB547;--ink:#9A5800;--shadow:0 30px 60px rgba(18,19,23,.22);
+  --codebg:#EAEAE5;--codebar:#E1E1DB;--inline:#E2E2DC;
+  --k:#7C35AB;--s:#2B6E3A;--c:#5F6570;--m:#8F4F00;--f:#1F5FA8;
+}
+/* No JavaScript: follow the system setting */
+@media (prefers-color-scheme:light){
+  :root:not([data-theme]){
+    color-scheme:light;
+    --bg:#F3F3F0;--bg2:#EAEAE5;--fg:#121317;--fgh:#000000;--body:#24262B;--muted:#585D67;--soft:#2E3138;--line:#D3D4CE;
+    --g1:#CFD0C8;--g2:#D8D9D2;--g3:#DFE0D9;--g4:#E5E6E0;--g5:#EBEBE6;--ds:#C2C3BC;
+    --accent:#FFB547;--ink:#9A5800;--shadow:0 30px 60px rgba(18,19,23,.22);
+    --codebg:#EAEAE5;--codebar:#E1E1DB;--inline:#E2E2DC;
+    --k:#7C35AB;--s:#2B6E3A;--c:#5F6570;--m:#8F4F00;--f:#1F5FA8;
+  }
+}
+
+/* ── Base ───────────────────────────────────────────────────────────────── */
+*,*::before,*::after{box-sizing:border-box}
+html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
+@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
+body{margin:0;background:var(--bg);color:var(--fg);font-family:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.5;transition:background-color .3s,color .3s}
+img{max-width:100%;height:auto}
+a{color:var(--fg)}
+a:hover{color:var(--fgh)}
+:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
+h1,h2,h3{margin:0}
+.mono{font-family:"JetBrains Mono",ui-monospace,monospace}
+.wrap{max-width:1280px;margin:0 auto;padding-left:24px;padding-right:24px}
+.skip{position:absolute;left:16px;top:-60px;z-index:10;padding:10px 16px;background:var(--fg);color:var(--bg);font-weight:600;text-decoration:none}
+.skip:focus{top:16px}
+main{display:block;overflow:hidden}
+.accent{color:var(--ink)}
+.link-ink{display:inline-flex;align-items:center;min-height:44px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:15px;color:var(--ink);text-decoration:none}
+.link-ink:hover{color:var(--ink);text-decoration:underline;text-underline-offset:4px}
+
+/* ── Dice ───────────────────────────────────────────────────────────────── */
+.die{position:absolute;display:block;pointer-events:none;overflow:visible}
+.die polygon{stroke:var(--ds);stroke-width:1px;stroke-linejoin:round;vector-effect:non-scaling-stroke;transition:fill .3s,stroke .3s}
+.die .g1{fill:var(--g1)}.die .g2{fill:var(--g2)}.die .g3{fill:var(--g3)}.die .g4{fill:var(--g4)}.die .g5{fill:var(--g5)}
+.die .ac{fill:var(--accent);fill-opacity:.92}
+.die .acl{fill:var(--accent);fill-opacity:.16}
+
+/* ── Header ─────────────────────────────────────────────────────────────── */
+.site-header{position:relative;z-index:2;display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;justify-content:space-between;padding-top:24px;padding-bottom:24px}
+.brand{display:inline-flex;align-items:center;min-height:44px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:15px;letter-spacing:.02em;text-decoration:none}
+.header-right{display:flex;flex-wrap:wrap;align-items:center;gap:12px 32px}
+.site-nav{display:flex;flex-wrap:wrap;gap:4px 28px}
+.site-nav a{display:inline-flex;align-items:baseline;gap:8px;min-height:44px;padding-top:12px;text-decoration:none;font-size:15px;font-weight:500}
+.site-nav .num{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12px;color:var(--ink)}
+.site-nav a[aria-current="page"] .label{border-bottom:2px solid var(--ink)}
+.theme-switch{display:none;padding:3px;gap:2px;border:1px solid var(--line);border-radius:999px;background:var(--bg)}
+.js .theme-switch{display:inline-flex}
+.theme-switch button{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:44px;min-height:40px;padding:0 12px;border:0;border-radius:999px;background:transparent;color:var(--muted);font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12px;cursor:pointer}
+.theme-switch button:hover{color:var(--fg)}
+.theme-switch button[aria-pressed="true"]{background:var(--fg);color:var(--bg)}
+.theme-switch button .t-label{display:none}
+.theme-switch button[aria-pressed="true"] .t-label{display:inline}
+.ico{display:block;width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8px;stroke-linecap:round;stroke-linejoin:round}
+
+/* ── Home: hero ─────────────────────────────────────────────────────────── */
+.hero{position:relative;min-height:760px}
+.hero .die{left:calc(50% + 80px);top:-150px;width:1040px;height:1040px;transform:rotate(11deg)}
+.hero__inner{position:relative;z-index:1;padding-top:120px;padding-bottom:140px}
+.hero__kicker{margin:0 0 28px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:14px;color:var(--muted)}
+.hero__title{max-width:min(820px,60vw);font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:clamp(52px,8vw,116px);line-height:.92;letter-spacing:-.045em}
+.hero__lede{margin:40px 0 0;max-width:560px;font-size:19px;line-height:1.6;color:var(--soft)}
+.index{position:relative;z-index:1;margin-top:-60px}
+.index__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));border-top:1px solid var(--line)}
+.index__item{display:flex;flex-direction:column;gap:10px;padding:28px 24px 32px 0;border-bottom:1px solid var(--line);text-decoration:none}
+.index__num{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:13px;color:var(--ink)}
+.index__name{font-family:"Space Grotesk",sans-serif;font-size:34px;font-weight:500;letter-spacing:-.02em}
+.index__meta{font-size:15px;color:var(--muted)}
+
+/* ── Home: sections ─────────────────────────────────────────────────────── */
+.section{position:relative;scroll-margin-top:0}
+.section--alt{background:var(--bg2)}
+.section__inner{position:relative;z-index:1;padding-top:160px;padding-bottom:140px}
+.sec-head{display:flex;flex-wrap:wrap;gap:16px 48px;align-items:flex-end;justify-content:space-between;margin-bottom:72px}
+.sec-title{font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:clamp(72px,12vw,176px);line-height:.85;letter-spacing:-.055em}
+.sec-title .eyebrow{display:block;margin-bottom:20px;font-family:"JetBrains Mono",ui-monospace,monospace;font-weight:400;font-size:14px;letter-spacing:0;color:var(--ink)}
+.sec-intro{margin:0;max-width:380px;font-size:17px;line-height:1.6;color:var(--muted)}
+.label{margin:0;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:14px;color:var(--muted)}
+#writing .die{left:-380px;top:80px;width:900px;height:900px;transform:rotate(-18deg)}
+#reading .die{right:-320px;top:-120px;width:960px;height:960px;transform:rotate(8deg)}
+#speaking .die{left:-300px;top:260px;width:880px;height:880px;transform:rotate(-24deg)}
+#contact .die{right:-200px;bottom:-260px;width:860px;height:860px;transform:rotate(16deg)}
+
+/* Writing rows (home and archive) */
+.post-row{display:flex;flex-wrap:wrap;gap:12px 48px;padding:28px 0;border-top:1px solid var(--line);text-decoration:none}
+.post-row:last-of-type{border-bottom:1px solid var(--line)}
+.post-row__date{flex:0 0 200px;padding-top:8px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:14px;color:var(--muted)}
+.post-row__body{flex:1 1 560px;min-width:0}
+.post-row__title{display:block;font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:30px;line-height:1.15;letter-spacing:-.015em}
+.post-row__desc{display:block;margin-top:8px;font-size:16px;line-height:1.55;color:var(--muted)}
+.post-row:hover .post-row__title{text-decoration:underline;text-decoration-color:var(--ink);text-decoration-thickness:2px;text-underline-offset:6px}
+.post-row--lead{gap:24px 48px;padding:40px 0 48px;border-top-color:var(--fg)}
+.post-row--lead .post-row__date{padding-top:12px;line-height:1.7;color:var(--ink)}
+.post-row--lead .post-row__title{font-size:clamp(36px,4.6vw,64px);line-height:1;letter-spacing:-.03em}
+.post-row--lead .post-row__desc{margin-top:18px;font-size:18px;color:var(--soft)}
+
+/* Reading */
+.reading{display:flex;flex-wrap:wrap-reverse;gap:64px;align-items:flex-end}
+.book-panel{flex:1 1 520px;min-width:0;scroll-margin-top:24px}
+.book-panel__top{display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end}
+.book-panel__cover{width:200px;max-width:100%;aspect-ratio:2/3;object-fit:cover;box-shadow:var(--shadow)}
+.book-panel__meta{flex:1 1 240px;min-width:0}
+.book-panel__eyebrow{margin:0;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:14px;color:var(--ink)}
+.book-panel__title{margin:14px 0 0;font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:clamp(30px,3.4vw,44px);line-height:1.04;letter-spacing:-.03em}
+.book-panel__author{margin:10px 0 0;font-size:17px;color:var(--muted)}
+.book-panel__note{margin-top:36px;max-width:640px;font-size:18px;line-height:1.65;color:var(--soft)}
+.book-panel__note p{margin:0 0 18px}
+.book-panel__note ul{margin:0 0 18px;padding-left:22px}
+.book-panel__note a{color:var(--fg);text-decoration-color:var(--ink);text-decoration-thickness:2px;text-underline-offset:4px}
+.shelf-wrap{flex:1 1 520px;min-width:0}
+.shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:28px 20px;margin:0;padding:0;list-style:none}
+.shelf__book{display:flex;flex-direction:column;gap:8px;width:100%;padding:0;border:0;background:none;color:var(--fg);text-align:left;font:inherit;cursor:pointer}
+.shelf__book img{width:100%;aspect-ratio:2/3;object-fit:cover;outline:2px solid transparent;outline-offset:4px;transition:outline-color .2s}
+.shelf__book[aria-pressed="true"] img{outline-color:var(--ink)}
+.shelf__book:hover img{outline-color:var(--line)}
+.shelf__book[aria-pressed="true"]:hover img{outline-color:var(--ink)}
+.shelf__title{margin-top:4px;font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:15px;line-height:1.2}
+.shelf__author{font-size:13px;color:var(--muted)}
+.shelf__tag{min-height:16px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12px;color:var(--muted)}
+.shelf__book[aria-pressed="true"] .shelf__tag{color:var(--ink)}
+.shelf__tag .is-on{display:none}
+.shelf__book[aria-pressed="true"] .shelf__tag .is-on{display:inline}
+.shelf__book[aria-pressed="true"] .shelf__tag .is-off{display:none}
+
+/* Speaking */
+.next-up{display:flex;flex-wrap:wrap;gap:24px 64px;align-items:flex-end;padding:40px 0 48px;border-top:1px solid var(--fg);border-bottom:1px solid var(--line)}
+.next-up__date{margin:12px 0 0;font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:clamp(48px,7vw,96px);line-height:.9;letter-spacing:-.04em;color:var(--ink)}
+.next-up__body{flex:1 1 280px;min-width:0}
+.next-up__name{margin:0;font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:30px;letter-spacing:-.015em}
+.next-up__place{margin:6px 0 0;font-size:16px;color:var(--muted)}
+.btn-outline{display:inline-flex;align-items:center;min-height:48px;padding:0 24px;border:1px solid var(--fg);text-decoration:none;font-weight:500;font-size:15px}
+.btn-outline:hover{background:var(--fg);color:var(--bg)}
+.also-upcoming{margin:0;padding:0;list-style:none}
+.also-upcoming li{display:flex;flex-wrap:wrap;gap:4px 24px;padding:16px 0;border-bottom:1px solid var(--line)}
+.also-upcoming .d{flex:0 0 200px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:14px;color:var(--muted)}
+.talks{border-top:1px solid var(--line)}
+.talk{border-bottom:1px solid var(--line)}
+.talk summary{display:grid;grid-template-columns:48px minmax(0,1fr) 28px;gap:16px;align-items:start;padding:26px 0;cursor:pointer;list-style:none}
+.talk summary::-webkit-details-marker{display:none}
+.talk__num{padding-top:7px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:14px;color:var(--ink)}
+.talk__title{font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:24px;line-height:1.25}
+.talk summary:hover .talk__title{text-decoration:underline;text-decoration-color:var(--ink);text-decoration-thickness:2px;text-underline-offset:5px}
+.talk .ico{width:22px;height:22px;margin-top:5px;transition:transform .2s}
+.talk[open] .ico{transform:rotate(45deg)}
+.talk__abstract{padding:0 44px 36px 64px;max-width:760px}
+.talk__abstract p{margin:0 0 16px;font-size:17px;line-height:1.7;color:var(--soft)}
+.talk__badge{display:inline-block;margin-left:10px;padding:1px 8px;border:1px solid var(--line);border-radius:999px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:11px;vertical-align:middle;color:var(--muted)}
+.past{display:grid;grid-template-columns:120px minmax(0,1fr);gap:16px 32px;padding:24px 0;border-bottom:1px solid var(--line)}
+.past__year{font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:28px;letter-spacing:-.02em}
+.past__list{margin:0;padding:0;list-style:none;font-size:17px;line-height:1.7;color:var(--soft)}
+.past__list li{display:inline}
+.past__list li:not(:last-child)::after{content:"\00B7";padding:0 .45em;color:var(--muted)}
+.past__list a{color:inherit;text-decoration:none}
+.past__list a:hover{color:var(--fg);text-decoration:underline;text-decoration-color:var(--ink);text-underline-offset:4px}
+
+/* Contact */
+.contact{margin-top:72px;display:flex;flex-wrap:wrap;gap:56px 80px;align-items:flex-start}
+.contact__main{flex:1 1 560px;min-width:0}
+.contact__pitch{margin:0;max-width:640px;font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:clamp(28px,3.2vw,40px);line-height:1.15;letter-spacing:-.02em}
+.contact__links{margin:48px 0 0;padding:0;list-style:none;border-top:1px solid var(--fg)}
+.contact__links a{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px 16px;min-height:76px;border-bottom:1px solid var(--line);text-decoration:none}
+.contact__links .n{font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:26px}
+.contact__links .h{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:15px;color:var(--muted)}
+.contact__links a:hover .n{color:var(--ink)}
+.contact__aside{flex:0 1 340px;min-width:0}
+.portrait{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;filter:grayscale(1) contrast(1.05)}
+.contact__aside .label{margin:24px 0 8px;color:var(--ink)}
+.contact__aside p.now{margin:0;font-size:16px;line-height:1.65;color:var(--soft)}
+
+/* Footer */
+.site-footer{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:12px 32px;justify-content:space-between;padding-top:32px;padding-bottom:48px;border-top:1px solid var(--line);font-family:"JetBrains Mono",ui-monospace,monospace;font-size:13px;color:var(--muted)}
+.site-footer a{color:inherit}
+
+/* ── Writing archive ────────────────────────────────────────────────────── */
+.archive{position:relative}
+.archive .die{right:-340px;top:-140px;width:920px;height:920px;transform:rotate(14deg)}
+.archive__inner{position:relative;z-index:1;padding-top:72px;padding-bottom:120px}
+.archive__head{margin:48px 0 88px}
+.year{display:flex;flex-wrap:wrap;gap:16px 48px;padding:36px 0 12px;border-top:1px solid var(--fg)}
+.year__label{flex:0 0 200px;font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:44px;line-height:1;letter-spacing:-.03em}
+.year__label span{display:block;margin-top:10px;font-family:"JetBrains Mono",ui-monospace,monospace;font-weight:400;font-size:13px;letter-spacing:0;color:var(--muted)}
+.year__posts{flex:1 1 560px;min-width:0}
+.arch-post{display:flex;flex-wrap:wrap;gap:4px 24px;padding:0 0 32px;text-decoration:none}
+.arch-post__day{flex:0 0 56px;padding-top:7px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:13px;color:var(--muted)}
+.arch-post__body{flex:1 1 420px;min-width:0}
+.arch-post__title{display:block;font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:26px;line-height:1.2;letter-spacing:-.015em}
+.arch-post__desc{display:block;margin-top:8px;font-size:16px;line-height:1.55;color:var(--muted)}
+.arch-post:hover .arch-post__title{text-decoration:underline;text-decoration-color:var(--ink);text-decoration-thickness:2px;text-underline-offset:5px}
+
+/* ── Post ───────────────────────────────────────────────────────────────── */
+.post-hero{position:relative}
+.post-hero .die{left:calc(50% + 200px);top:-200px;width:900px;height:900px;transform:rotate(-9deg)}
+.post-hero__inner{position:relative;z-index:1;padding-top:56px;padding-bottom:112px}
+.post-hero__meta{margin:56px 0 0;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:14px;color:var(--muted)}
+.post-hero__title{margin-top:20px;max-width:min(980px,68vw);font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:clamp(46px,6.6vw,96px);line-height:.95;letter-spacing:-.045em}
+.post-hero__lede{margin:36px 0 0;max-width:640px;font-size:22px;line-height:1.5;color:var(--soft)}
+.post-body{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:48px 96px;align-items:flex-start;padding-bottom:48px}
+.toc{flex:0 1 248px;min-width:0;padding-top:6px}
+.toc ol{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}
+.toc li{border-bottom:1px solid var(--line)}
+.toc li a{display:grid;grid-template-columns:32px minmax(0,1fr);gap:8px;padding:12px 0;text-decoration:none;font-size:15px;line-height:1.35}
+.toc li a:hover{color:var(--ink)}
+.toc .n{padding-top:2px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12px;color:var(--ink)}
+.toc .label{margin:0 0 14px;font-size:13px}
+
+.prose{flex:1 1 640px;min-width:0;max-width:720px;font-size:19px;line-height:1.75;color:var(--body);counter-reset:sec}
+.prose>p,.prose>div>p{margin:0 0 28px}
+.prose>:first-child{margin-top:0}
+.prose a{color:var(--fg);text-decoration:underline;text-decoration-color:var(--ink);text-decoration-thickness:2px;text-underline-offset:4px}
+.prose a:hover{color:var(--ink)}
+.prose strong{color:var(--fg);font-weight:600}
+.prose h2{counter-increment:sec;margin:96px 0 24px;font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:40px;line-height:1.05;letter-spacing:-.03em;color:var(--fg);scroll-margin-top:24px}
+.prose h2::before{content:counter(sec,decimal-leading-zero);display:block;margin-bottom:14px;font-family:"JetBrains Mono",ui-monospace,monospace;font-weight:400;font-size:14px;letter-spacing:0;color:var(--ink)}
+.prose h3{margin:56px 0 16px;font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:26px;line-height:1.2;color:var(--fg);scroll-margin-top:24px}
+.prose h4{margin:40px 0 12px;font-size:19px;font-weight:600;color:var(--fg)}
+.prose ul,.prose ol{margin:0 0 28px;padding-left:1.4em}
+.prose li{margin:0 0 10px;padding-left:.3em}
+.prose li>p{margin:0 0 10px}
+.prose ol li::marker{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.8em;color:var(--ink)}
+.prose ul li::marker{color:var(--ink)}
+.prose blockquote{margin:48px 0;padding:28px 0 0;border-top:1px solid var(--fg);font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:30px;line-height:1.25;letter-spacing:-.015em;color:var(--fg)}
+.prose blockquote p{margin:0 0 16px}
+.prose img{display:block;height:auto;margin:48px 0 0}
+.prose p>img:only-child{margin:0}
+.prose figure{margin:48px 0}
+.prose figure img{margin:0;width:auto;max-width:100%}
+.prose figcaption{margin-top:12px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:13px;color:var(--muted)}
+.prose hr{border:0;border-top:1px solid var(--line);margin:56px 0}
+.prose table{display:block;max-width:100%;overflow-x:auto;margin:0 0 32px;border-collapse:collapse;font-size:16px}
+.prose th,.prose td{padding:10px 16px 10px 0;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
+.prose th{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:13px;font-weight:500;color:var(--muted);border-bottom-color:var(--fg)}
+.prose :not(pre)>code{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.84em;padding:.15em .4em;border-radius:4px;background:var(--inline);color:var(--fg);overflow-wrap:anywhere}
+.prose pre{margin:0 0 28px;padding:20px 22px;overflow-x:auto;background:var(--codebg);border:1px solid var(--line);font-family:"JetBrains Mono",ui-monospace,monospace;font-size:14px;line-height:1.7;color:var(--fg);tab-size:4}
+
+/* Book covers beside the text: _includes/book-aside.html */
+.prose .book-aside{float:right;width:168px;margin:8px 0 24px 40px}
+.prose .book-aside a{display:block}
+.prose .book-aside img{display:block;width:100%;margin:0;box-shadow:var(--shadow)}
+.prose .book-aside figcaption{margin-top:12px;line-height:1.5}
+.prose .book-aside .t{display:block;color:var(--fg)}
+.prose h2{clear:both}
+
+/* Code blocks (kramdown + Rouge output, plus the bar site.js adds) */
+.prose div.highlighter-rouge{margin:36px 0;border:1px solid var(--line);background:var(--codebg)}
+.prose div.highlighter-rouge pre,.prose div.highlighter-rouge .highlight{margin:0;border:0;background:none}
+.code-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:44px;padding:0 6px 0 18px;background:var(--codebar);border-bottom:1px solid var(--line);font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12px;color:var(--muted)}
+.code-bar button{display:inline-flex;align-items:center;gap:6px;min-height:36px;min-width:44px;padding:0 12px;border:0;border-radius:4px;background:none;color:var(--muted);font:inherit;cursor:pointer}
+.code-bar button:hover{color:var(--fg);background:var(--inline)}
+.code-bar .ico{width:14px;height:14px}
+.highlight .k,.highlight .kd,.highlight .kn,.highlight .kp,.highlight .kr,.highlight .kt,.highlight .kc,.highlight .ow,.highlight .nt{color:var(--k)}
+.highlight .s,.highlight .s1,.highlight .s2,.highlight .sb,.highlight .sc,.highlight .sd,.highlight .se,.highlight .sh,.highlight .si,.highlight .sx,.highlight .sr,.highlight .ss,.highlight .dl{color:var(--s)}
+.highlight .c,.highlight .c1,.highlight .cm,.highlight .cs,.highlight .cp,.highlight .cpf{color:var(--c);font-style:italic}
+.highlight .m,.highlight .mi,.highlight .mf,.highlight .mh,.highlight .mo,.highlight .il,.highlight .na{color:var(--m)}
+.highlight .nf,.highlight .fm,.highlight .nc,.highlight .nb,.highlight .bp,.highlight .nn{color:var(--f)}
+.highlight .err{color:inherit;background:none}
+
+/* Chat transcripts in posts */
+.transcript{margin:40px 0 8px;border-top:1px solid var(--fg)}
+.msg{display:grid;grid-template-columns:132px minmax(0,1fr);gap:6px 24px;padding:22px 0;border-bottom:1px solid var(--line)}
+.who{padding-top:4px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12px;line-height:1.5;color:var(--muted)}
+.who b{display:block;margin-bottom:2px;font-weight:500;font-size:14px;color:var(--fg)}
+.msg--dm .who b{color:var(--ink)}
+.badge{display:inline-block;margin-top:8px;padding:1px 8px;border:1px solid var(--line);border-radius:999px;font-size:11px}
+.msg p{margin:0;font-size:17px;line-height:1.7}
+
+/* Post footer */
+.post-end{position:relative;z-index:1;margin-top:72px;border-top:1px solid var(--line)}
+.post-end__inner{padding-top:80px;padding-bottom:24px}
+.author{display:flex;flex-wrap:wrap;gap:32px 40px;align-items:flex-start;max-width:860px}
+.author img{width:120px;height:120px;object-fit:cover;filter:grayscale(1) contrast(1.05)}
+.author__body{flex:1 1 420px;min-width:0}
+.author__name{margin:8px 0 0;font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:30px;letter-spacing:-.02em}
+.author__bio{margin:12px 0 0;font-size:17px;line-height:1.6;color:var(--soft)}
+.author__links{display:flex;flex-wrap:wrap;gap:4px 24px;margin-top:12px}
+.author__links a{font-size:14px}
+.post-nav{margin-top:96px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:0 48px}
+.post-nav a{display:flex;flex-direction:column;gap:12px;padding:28px 0 36px;border-top:1px solid var(--fg);text-decoration:none}
+.post-nav .next{text-align:right}
+.post-nav .k{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:13px;color:var(--muted)}
+.post-nav .t{font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:26px;line-height:1.2;letter-spacing:-.015em}
+.post-nav a:hover .t{color:var(--ink)}
+
+/* 404 */
+.lost{position:relative;min-height:70vh}
+.lost .die{right:-220px;top:-120px;width:760px;height:760px;transform:rotate(-14deg)}
+.lost__inner{position:relative;z-index:1;padding-top:96px;padding-bottom:120px}
+.lost__img{display:block;width:100%;max-width:560px;margin-top:56px}
+
+/* ── Small screens ──────────────────────────────────────────────────────── */
+@media (max-width:760px){
+  .die .ac{fill:var(--g1);fill-opacity:1}
+  .die .acl{fill:var(--g1);fill-opacity:1}
+  .hero{min-height:0}
+  .hero .die{left:auto;width:620px;height:620px;right:-320px;top:-40px}
+  .hero__title,.post-hero__title{max-width:none}
+  .hero__inner{padding-top:72px;padding-bottom:120px}
+  .section__inner{padding-top:112px;padding-bottom:96px}
+  #writing .die,#reading .die,#speaking .die,#contact .die,.archive .die{width:560px;height:560px}
+  .post-hero .die{left:auto;width:520px;height:520px;right:-260px;top:-120px}
+  .post-row__date,.year__label{flex-basis:100%}
+  .past{grid-template-columns:minmax(0,1fr);gap:8px}
+  .talk__abstract{padding:0 0 32px 0}
+  .msg{grid-template-columns:minmax(0,1fr)}
+  .prose{font-size:18px}
+  .prose h2{font-size:32px;margin-top:72px}
+  .prose blockquote{font-size:24px}
+  .post-nav .next{text-align:left}
+  .prose .book-aside{width:112px;margin-left:20px}
+}
